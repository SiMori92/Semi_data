{
  "_doc": {
    "overview": "Interactive Brokers API configuration for real-time options implied-volatility data.",
    "requirements": [
      "1. Install TWS (Trader Workstation) or IB Gateway from https://www.interactivebrokers.com/en/trading/tws.php",
      "2. In TWS: Edit → Global Configuration → API → Settings",
      "     ✅ Enable ActiveX and Socket Clients",
      "     ✅ Add 127.0.0.1 to Trusted IP Addresses",
      "     ✅ Read-Only API (tick this for safety — we only read data)",
      "     Set Socket port to match the 'port' value below",
      "3. Set 'enabled': true and run:  python ibkr_options_crawler.py"
    ],
    "port_guide": {
      "TWS_Live_Trading":    7496,
      "TWS_Paper_Trading":   7497,
      "IB_Gateway_Live":     4001,
      "IB_Gateway_Paper":    4002
    },
    "client_id_note": "Each simultaneous API connection needs a unique client_id (1–999). Use 10 unless you have other bots connecting.",
    "paper_trading_note": "Strongly recommended: use paper trading port (7497 / 4002) for data-only work. Live and paper return identical market data."
  },

  "enabled": false,

  "connection": {
    "host":             "127.0.0.1",
    "port":             7497,
    "client_id":        10,
    "timeout_seconds":  30,
    "readonly":         true
  },

  "crawl_settings": {
    "history_duration":          "1 Y",
    "bar_size":                  "1 day",
    "use_rth":                   true,
    "delay_between_requests_s":  1.5,
    "max_retries":               2,
    "iv_windows": {
      "_doc": "Rolling window sizes (trading days) for IV averages",
      "1_month":    21,
      "1_quarter":  63,
      "6_months":  126,
      "1_year":    252
    }
  },

  "ticker_contracts": {
