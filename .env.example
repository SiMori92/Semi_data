# ── .env.example ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values for local development.
# On Railway / Render / Fly.io, set these as environment variables in the
# platform dashboard — do NOT commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Path to the SQLite database file.
# On cloud: set this to the path inside your persistent volume, e.g. /data/semiconductor_data.db
# Locally: leave blank to use the default (semiconductor_data.db in the project folder)
DB_PATH=semiconductor_data.db

# Port the web server listens on.
# Cloud platforms (Railway, Render, Fly.io) inject $PORT automatically — you
# do not need to set this manually on those platforms.
PORT=8050

# Secret key shared between the cloud app and your local ibkr_relay.py script.
# Must be a long random string — generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# Leave blank to disable authentication on /api/upload-iv (not recommended in production).
RELAY_API_KEY=your-secret-key-here
